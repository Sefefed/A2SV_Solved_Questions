n, k = map(int, input().split())
arr = list(map(int, input().split()))

from collections import defaultdict

freq = defaultdict(int)
i = 0
distinct = 0
ans = 0

for j in range(n):
    if freq[arr[j]] == 0:
        distinct += 1
    freq[arr[j]] += 1

    while distinct > k:
        freq[arr[i]] -= 1
        if freq[arr[i]] == 0:
            distinct -= 1
        i += 1

    ans += j - i + 1

print(ans)
